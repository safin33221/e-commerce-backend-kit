model Category {
    id String @id @default(cuid())

    name String

    slug String @unique

    image String?

    parentId String?

    parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])

    children Category[] @relation("CategoryHierarchy")

    products Product[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
